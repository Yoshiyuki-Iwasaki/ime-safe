{
  "name": "ime-safe",
  "version": "0.0.0",
  "description": "IME-safe keyboard handling utilities for React",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/isIMEComposing.d.ts",
      "import": "./dist/isIMEComposing.js",
      "default": "./dist/isIMEComposing.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoshiyuki-Iwasaki/ime-safe.git"
  },
  "bugs": {
    "url": "https://github.com/Yoshiyuki-Iwasaki/ime-safe/issues"
  },
  "homepage": "https://github.com/Yoshiyuki-Iwasaki/ime-safe#readme",
  "keywords": [
    "react",
    "ime",
    "keyboard",
    "composition",
    "typescript"
  ]
}
